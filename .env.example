# Copy to .env (git-ignored). Everything is optional: with no values the app runs fully offline in DEMO MODE.
# Never commit real credentials. On AWS these values come from the SAM stack, not from this file.

DEMO_MODE=true                 # demo accounts on the login page, demo fast-forward button, demo data seeding
APP_ENV=local                  # local | test | production (production refuses the insecure dev JWT secret)

# ---- AWS (leave blank for demo mode) -------------------------------------------------------------------------
AWS_REGION=ap-south-1          # API, database, storage and sign-in region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=us-east-1       # region where your Bedrock model is enabled
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0   # multimodal model that supports the Converse API and tool use
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
S3_BUCKET=
DYNAMODB_TABLE=

# ---- Provider selection ("auto" = AWS when configured / running in Lambda, otherwise local) -----------------
AI_PROVIDER=auto               # auto | mock | bedrock     (set bedrock to try real Bedrock from your laptop)
STORE_BACKEND=auto             # auto | memory | dynamodb
STORAGE_BACKEND=auto           # auto | local | s3
AUTH_PROVIDER=auto             # auto | dev | cognito
USE_STRANDS=true               # drive the tools with the Strands Agents SDK when Bedrock is the provider

# ---- App settings --------------------------------------------------------------------------------------------
DEV_JWT_SECRET=dev-only-insecure-secret-change-me   # only used by the dev auth provider
DEMO_PASSWORD=ReLoop#Demo1     # password of the demo accounts (demo data only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=4                # keep <= 4 on Lambda (6 MB payload limit after base64)
SUBMISSION_COOLDOWN_SECONDS=3
LOCAL_DATA_DIR=../.data

# ---- Locale (i18n-ready defaults: India / INR / kg) ------------------------------------------------------------
CURRENCY=INR
CURRENCY_SYMBOL=₹
WEIGHT_UNIT=kg
COUNTRY=IN
LOCALE=en-IN
